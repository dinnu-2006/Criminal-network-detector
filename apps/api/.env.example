# Environment Configuration
# Copy to .env and fill in values

# App
APP_NAME=CrimNet Intel
APP_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-please
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crimnet
POSTGRES_USER=crimnet
POSTGRES_PASSWORD=crimnet_dev_pass

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=crimnet_dev_pass

# OpenSearch
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# JWT Auth
JWT_SECRET_KEY=jwt-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# Demo mode
DEMO_MODE=true
